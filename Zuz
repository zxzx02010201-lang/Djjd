-- プレイヤー選択→テレポート掴み→元位置帰還（なんかわからん.txt 完全移植）
----------------------------------------------------------------
local grabReturnExecuting = false
local selectedGrabPlayerName = nil

local function executeGrabReturn(targetPlayer)
    if grabReturnExecuting then return end
    grabReturnExecuting = true

    local char = LocalPlayer.Character
    if not char then grabReturnExecuting = false return end
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    if not myHrp then grabReturnExecuting = false return end

    local targetChar = targetPlayer.Character
    if not targetChar then grabReturnExecuting = false return end
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHrp then grabReturnExecuting = false return end

    -- 1. 自分が選択する前の元の位置を記憶
    local originalMyCFrame = myHrp.CFrame

    -- 2. 対象プレイヤーの場所へ自分がテレポート
    myHrp.CFrame = targetHrp.CFrame + Vector3.new(0, 2, 3)

    -- 3. 視線をがっちり相手に向ける（一時的なカメラロック）
    camera.CameraType = Enum.CameraType.Scriptable
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if targetHrp and targetHrp.Parent and myHrp and myHrp.Parent then
            camera.CFrame = CFrame.lookAt(myHrp.Position + Vector3.new(0, 2, 4), targetHrp.Position)
        end
    end)

    task.wait(0.15) -- テレポートとカメラの安定化待ち

    -- 4. 画面の中央座標を取得してクリック（掴み操作）
    local viewportSize = camera.ViewportSize
    local centerPos = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    -- 1回目のクリック
    VirtualUser:Button1Down(centerPos)
    task.wait(0.08)
    VirtualUser:Button1Up(centerPos)

    task.wait(0.1)

    -- 2回目のクリック
    VirtualUser:Button1Down(centerPos)
    task.wait(0.08)
    VirtualUser:Button1Up(centerPos)

    -- 5. 掴んだ状態を維持して連れてくるための間
    task.wait(0.6)

    -- 6. 元々自分がいた場所に、自分と選択したプレイヤーの両方を戻す
    myHrp.CFrame = originalMyCFrame
    myHrp.AssemblyLinearVelocity = Vector3.zero
    myHrp.AssemblyAngularVelocity = Vector3.zero

    if targetHrp and targetHrp.Parent then
        targetHrp.CFrame = originalMyCFrame * CFrame.new(0, 0, 3)
        targetHrp.AssemblyLinearVelocity = Vector3.zero
        targetHrp.AssemblyAngularVelocity = Vector3.zero
    end

    -- カメラを元に戻す
    if connection then connection:Disconnect() end
    camera.CameraType = Enum.CameraType.Custom

    OrionLib:MakeNotification({
        Name = "掴み帰還",
        Content = targetPlayer.Name .. " を連れて帰還しました",
        Time = 3
    })

    grabReturnExecuting = false
end

local function getGrabPlayerList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.DisplayName .. " (@" .. plr.Name .. ")")
        end
    end
    if #list == 0 then table.insert(list, "他のプレイヤーがいません") end
    return list
end

