-- キーシステム（Orion UI形式）
----------------------------------------------------------------
local KEY_SYSTEM = {
    Enabled = true,
    CorrectKey = "EBIHUB", -- ★ここを好きなキーに変更
    GetKeyLink = "", -- 例: "https://discord.gg/xxxx" 空ならボタン非表示
}

local function runKeySystem()
    if not KEY_SYSTEM.Enabled then return true end

    -- getgenv に既に正しいキーが入っていればスキップ
    if getgenv and getgenv().EBIHubKey == KEY_SYSTEM.CorrectKey then
        return true
    end

    local verified = false
    local enteredKey = ""

    -- Orion UI キー認証ウィンドウ
    local KeyWindow = OrionLib:MakeWindow({
        Name = "EBI hub - Key System",
        HidePremium = false,
        SaveConfig = false,
        IntroEnabled = false,
    })

    local KeyTab = KeyWindow:MakeTab({
        Name = "認証",
        Icon = "rbxassetid://4483345998",
        PremiumOnly = false
    })

    KeyTab:AddParagraph("Key System", "正しいキーを入力して認証してください。")

    KeyTab:AddTextbox({
        Name = "キーを入力",
        Default = "",
        TextDisappear = false,
        Callback = function(Value)
            enteredKey = Value
        end
    })

    KeyTab:AddButton({
        Name = "認証する",
        Callback = function()
            local input = (enteredKey or ""):gsub("%s+", "")
            if input == KEY_SYSTEM.CorrectKey then
                verified = true
                if getgenv then getgenv().EBIHubKey = KEY_SYSTEM.CorrectKey end
                OrionLib:MakeNotification({
                    Name = "認証成功",
                    Content = "EBI hub を起動します…",
                    Time = 2
                })
                -- キー画面を確実に消す（Orion本体は残して後続の本体UIを起動可能にする）
                task.spawn(function()
                    task.wait(0.25)
                    pcall(function()
                        if typeof(KeyWindow) == "table" then
                            if KeyWindow.Destroy then KeyWindow:Destroy() end
                            if KeyWindow.Close then KeyWindow:Close() end
                        end
                    end)
                    pcall(function()
                        local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
                        if not pg then return end
                        for _, gui in ipairs(pg:GetChildren()) do
                            if gui:IsA("ScreenGui") then
                                local n = string.lower(tostring(gui.Name))
                                -- キー用ウィンドウだけ消す（名前に Key / KeySystem を含むもの）
                                if string.find(n, "key") then
                                    gui:Destroy()
                                end
                            end
                        end
                        -- Orionのメインフレームが残っている場合、キーウィンドウ名で特定できなければ
                        -- 表示中のOrion GUIを一度閉じてから本体で作り直す
                        for _, gui in ipairs(pg:GetChildren()) do
                            if gui:IsA("ScreenGui") and string.find(string.lower(tostring(gui.Name)), "orion") then
                                gui:Destroy()
                            end
                        end
                    end)
                end)
            else
                OrionLib:MakeNotification({
                    Name = "認証失敗",
                    Content = "キーが違います",
                    Time = 3
                })
            end
        end
    })

    if KEY_SYSTEM.GetKeyLink and KEY_SYSTEM.GetKeyLink ~= "" then
        KeyTab:AddButton({
            Name = "キーを取得（リンクコピー）",
            Callback = function()
                pcall(function()
                    if setclipboard then setclipboard(KEY_SYSTEM.GetKeyLink) end
                end)
                OrionLib:MakeNotification({
                    Name = "コピー完了",
                    Content = "リンクをクリップボードにコピーしました",
                    Time = 2
                })
            end
        })
    end

    OrionLib:Init()

    -- 認証完了まで待機
    while not verified do
        task.wait(0.15)
    end

    return verified
end

if not runKeySystem() then
    warn("[EBI hub] Key verification failed / cancelled.")
    return
end

