        atmo.Density = 0.3; atmo.Color = Color3.fromRGB(220, 60, 60); atmo.Decay = Color3.fromRGB(160, 30, 30); atmo.Glare = 0.2; atmo.Haze = 1.2; sky.StarCount = 0
