    local kickV1Enabled, kickV1Thread = false, nil
    local function toggleV1Kick(on)
        if kickV1Thread then task.cancel(kickV1Thread) kickV1Thread = nil end
        kickV1Enabled = on
        if not on then GKLib.resetHands() return end

        kickV1Thread = task.spawn(function()
            local GE = ReplicatedStorage:WaitForChild("GrabEvents")
            local REMOTE_DELAY = 0.002
            local lastRemote = 0

            while kickV1Enabled and autoSitEnabled do
                local target = selectedTargetPlayer
                if not GKLib.IsTargetValid(target) then
                    task.wait(0.2)
                else
                    local blob, blobRoot, CG, CD = GKLib.EnsureReadyForKick()
                    if not blob or not blobRoot then
                        task.wait(0.5)
                    else
                        local savedPos = blobRoot.CFrame
                        local dragging = false
                        local grabStartTime = 0

                        while kickV1Enabled and autoSitEnabled and GKLib.IsTargetValid(target) and selectedTargetPlayer == target do
                            local seat = GKLib.getBlobmanSeat()
                            if not seat then break end
                            blob = seat.Parent
                            blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart

                            local tChar = target.Character
                            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                            local tHum = tChar and tChar:FindFirstChild("Humanoid")

                            if tRoot and tHum and tHum.Health > 0 and blobRoot then
                                tRoot.Velocity = Vector3.zero

                                if not dragging then
                                    GKLib.ApplyCFrame(blobRoot, tRoot.CFrame)

                                    if tick() - lastRemote >= REMOTE_DELAY then
                                        lastRemote = tick()
                                        pcall(function()
                                            tHum.PlatformStand = true
                                            tHum.Sit = true
                                            GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                                            GE.DestroyGrabLine:FireServer(tRoot)
                                        end)
                                    end

                                    if grabStartTime == 0 then
                                        grabStartTime = tick()
                                    end

                                    if tick() - grabStartTime > 0.35 then
                                        dragging = true
                                        grabStartTime = 0
                                        GKLib.ApplyCFrame(blobRoot, savedPos)
                                    end
                                else
                                    GKLib.ApplyCFrame(blobRoot, savedPos)
                                    local lockPos = savedPos * CFrame.new(0, 23, 0)
                                    tRoot.CFrame = lockPos
                                    tHum.PlatformStand = true
                                    tHum.Sit = true

                                    if tick() - lastRemote >= REMOTE_DELAY then
                                        lastRemote = tick()
                                        pcall(function()
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.DestroyGrabLine:FireServer(tRoot)

                                            local R_Det = blob:FindFirstChild("RightDetector")
                                            local weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld"))
                                            if R_Det and weld and CD and CG then
                                                CD:FireServer(weld)
                                                CG:FireServer(R_Det, tRoot, weld)
                                            end
                                        end)
                                    end
                                end
                            else
                                dragging = false
                                grabStartTime = 0
                            end

                            RunService.Heartbeat:Wait()
                        end
                        if blobRoot and savedPos then
                            GKLib.ApplyCFrame(blobRoot, savedPos)
                        end
                    end
                end
                RunService.Heartbeat:Wait()
            end
            GKLib.resetHands()
        end)
    end

