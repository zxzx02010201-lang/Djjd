    -- ✈️ 巨人飛行控制與設定
    local flightSpeed = 60
    KickTab:AddSlider({Name = "✈️ 飛行速度", Min = 10, Max = 200, Default = 60, Increment = 5, ValueName = "studs/s", Callback = function(v) flightSpeed = v end})

