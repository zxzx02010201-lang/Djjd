    })

    -- ==========================================
    -- 6. XOCU Lag 與 Line Lag (含強度拉桿與關閉自動清理) 區塊
    -- ==========================================
    KickTab:AddSection({Name = "--- [ 伺服器線卡頓與防 Lag 控制 ] ---"})

    -- 清理 GrabLine 的獨立輔助函數 (遠端事件回收)
    local function purgeAllGrabLines()
        pcall(function()
            local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
            local destroyRemote = GE and GE:FindFirstChild("DestroyGrabLine")
            if destroyRemote then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        destroyRemote:FireServer(plr.Character.HumanoidRootPart)
                    end
                end
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    destroyRemote:FireServer(LocalPlayer.Character.HumanoidRootPart)
                end
            end
        end)
    end

    -- 1. XOCU Lag (關閉時自動清理)
    _G.MonsterLagEnabled = false
    local monsterLagThread = nil

    KickTab:AddToggle({
        Name = "<font color='#8B0000'><b>🔥 XOCU Lag (伺服器負載攻擊)</b></font>", 
        Default = false,
        Callback = function(Value)
            _G.MonsterLagEnabled = Value
            if monsterLagThread then 
                task.cancel(monsterLagThread) 
                monsterLagThread = nil 
            end
            
            if Value then
                monsterLagThread = task.spawn(function()
                    local RepS = ReplicatedStorage
                    local WS = Workspace
                    local LP = LocalPlayer
                    local GrabEvents = RepS:FindFirstChild("GrabEvents")
                    local CreateLine = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")

                    while _G.MonsterLagEnabled and CreateLine do
                        local spawnLocation = WS:FindFirstChild("SpawnLocation") 
                            or WS:FindFirstChild("Spawn") 
                            or (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"))

                        if spawnLocation then
                            local randomX = math.random(-9e9, 9e9)
                            local randomZ = math.random(-9e9, 9e9)
                            pcall(function()
                                CreateLine:FireServer(spawnLocation, CFrame.new(randomX, 0, randomZ))
                            end)
                        end
                        task.wait()
                    end
                end)
            else
                purgeAllGrabLines() -- 關閉時立刻清除線段
            end
        end
    })

    -- 2. Line Lag (含可調強度拉桿，關閉時自動清理)
    local lineLagActive = false
    local lineLagTask = nil
    local lineLagMultiplier = 5 -- 預設發送倍數

    KickTab:AddSlider({
        Name = "⚡ Line Lag 強度 (倍率 1-50)",
        Min = 1,
        Max = 50,
        Default = 5,
        Increment = 1,
        ValueName = "倍",
        Callback = function(v)
            lineLagMultiplier = v
        end
    })

    KickTab:AddToggle({
        Name = "Line Lag",
        Default = false,
        Callback = function(v)
            lineLagActive = v
            if lineLagTask then
                task.cancel(lineLagTask)
                lineLagTask = nil
            end
            if v then
                lineLagTask = task.spawn(function()
                    local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
                    local CreateGrabLine = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")
                    
                    while lineLagActive and CreateGrabLine do
                        local SpawnLocation = Workspace:FindFirstChild("SpawnLocation") 
                            or Workspace:FindFirstChild("Spawn") 
                            or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))

                        if SpawnLocation then
                            local sendAmount = 20 * lineLagMultiplier
                            for _ = 1, sendAmount do
                                if not lineLagActive then break end
                                local randomX = math.random(-1000000000, 1000000000)
                                local randomZ = math.random(-1000000000, 1000000000)

                                pcall(function()
                                    CreateGrabLine:FireServer(SpawnLocation, CFrame.new(randomX, 0, randomZ))
                                end)
                            end
                        end

                        task.wait(0.02)
                    end
                end)
            else
                purgeAllGrabLines() -- 關閉時立刻清除線段
            end
        end
    })

    local antiLagCleanupThread = nil
    local antiLagCleanupEnabled = false

    KickTab:AddToggle({
        Name = "🛡️ 防 Lag 刪除 (開闢獨立線路清理 GrabLine)", 
        Default = false,
        Callback = function(state)
            antiLagCleanupEnabled = state
            if antiLagCleanupThread then
                task.cancel(antiLagCleanupThread)
                antiLagCleanupThread = nil
            end

            if state then
                antiLagCleanupThread = task.spawn(function()
                    while antiLagCleanupEnabled do
                        if not _G.MonsterLagEnabled and not lineLagActive then
                            purgeAllGrabLines()
                        end
                        task.wait(0.1)
                    end
                end)
            else
                purgeAllGrabLines()
            end
        end
    })

    -- ==========================================
    -- 7. 包裹卡頓 (Packet Lag) 獨立區塊
    -- ==========================================
    KickTab:AddSection({Name = "--- [ 包裹卡頓 (Packet Lag) 控制 ] ---"})

    local packetLagActive = false
    local packetLagTask = nil
    local packetLagSize = 1

    local function getPacketSize()
        return packetLagSize * 1000000
    end

    KickTab:AddSlider({
        Name = "📦 Packet Size (MB)",
        Min = 1,
        Max = 20,
        Default = 1,
        Increment = 1,
        ValueName = "MB",
        Callback = function(v)
            packetLagSize = v
        end
    })

    KickTab:AddButton({
        Name = "📦 發送包裹卡頓 (單次)",
        Callback = function()
            local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
            local ExtendGrabLine = GrabEvents and GrabEvents:FindFirstChild("ExtendGrabLine")
            if not ExtendGrabLine then return end
            local size = getPacketSize()
            pcall(function()
                ExtendGrabLine:FireServer(string.rep("A", size))
            end)
        end
    })

    KickTab:AddToggle({
        Name = "📦 包裹卡頓 (迴圈循環)",
        Default = false,
        Callback = function(Value)
            packetLagActive = Value
            if packetLagTask then
                task.cancel(packetLagTask)
                packetLagTask = nil
            end
            
            if Value then
                packetLagTask = task.spawn(function()
                    local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
                    local ExtendGrabLine = GrabEvents and GrabEvents:FindFirstChild("ExtendGrabLine")
                    if not ExtendGrabLine then
                        packetLagActive = false
                        return
                    end
                    local size = getPacketSize()
                    while packetLagActive do
                        task.wait(0.5)
                        pcall(function()
                            ExtendGrabLine:FireServer(string.rep("A", size))
                        end)
                    end
                end)
            else
                pcall(function()
                    local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
                    local ExtendGrabLine = GrabEvents and GrabEvents:FindFirstChild("ExtendGrabLine")
                    if ExtendGrabLine then
                        ExtendGrabLine:FireServer("")
                    end
                end)
            end
        end
    })

