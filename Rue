-- =========== 巨人踢 v2.2.4 (遠端事件回收與手臂狀態完美恢復 - 關閉自動清理 Lag 版) ===========
-- ===========================================================================================================

task.spawn(function()
    task.wait(1.0)

    -- 0. 環境服務
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Workspace = game:GetService("Workspace")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer

    -- 嘗試自動對接主視窗
    local gk_MainWindow = nil
    pcall(function()
        gk_MainWindow = aa56 or Window or UI or Rayfield or OrionLib
        if not gk_MainWindow then
            for _, v in pairs(getfenv()) do
                if type(v) == "table" and (rawget(v, "MakeTab") or rawget(v, "CreateTab")) then
                    gk_MainWindow = v
                    break
                end
            end
        end
    end)

    if not gk_MainWindow then
        warn("[巨人踢模組] ❌ 尚未偵測到主視窗，請確認是否已載入主腳本！")
        return
    end

    -- =========================================================================================
    -- 1. 巨人踢底層核心工具與共用程序打包 (GKLib 封包)
    -- =========================================================================================
    local GKLib = {}

    function GKLib.getChar() return LocalPlayer.Character end
    function GKLib.getRoot()
        local c = GKLib.getChar()
        return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
    end
    function GKLib.getHum()
        local c = GKLib.getChar()
        return c and c:FindFirstChildOfClass("Humanoid")
    end
    function GKLib.getInv()
        return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    end

    function GKLib.SetNetworkOwner(part)
        if not part or not part.Parent then return end
        local ge = ReplicatedStorage:FindFirstChild("GrabEvents")
        local root = GKLib.getRoot()
        if ge and ge:FindFirstChild("SetNetworkOwner") and root then
            pcall(function() ge.SetNetworkOwner:FireServer(part, root.CFrame) end)
        end
    end

    function GKLib.IsTargetValid(target)
        if not target or not target.Parent or not target:IsDescendantOf(Players) then return false end
        local char = target.Character
        if not char or not char.Parent then return false end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        return root and hum and hum.Health > 0
    end

    function GKLib.ApplyCFrame(part, cf)
        if not part or not part.Parent then return end
        part.CFrame = cf
        part.Velocity = Vector3.zero
        part.RotVelocity = Vector3.zero
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end

    function GKLib.KeepUpright(part, targetCF)
        if not part or not part.Parent then return end
        local _, yAngle, _ = targetCF:ToOrientation()
        GKLib.ApplyCFrame(part, CFrame.new(targetCF.Position) * CFrame.Angles(0, yAngle, 0))
    end

    function GKLib.getToy(toyName)
        local inv = GKLib.getInv()
        if inv and inv:FindFirstChild(toyName) then return inv[toyName] end
        local plotItems = Workspace:FindFirstChild("PlotItems")
        if plotItems then
            for _, p in pairs(plotItems:GetChildren()) do
                local m = p:FindFirstChild(toyName)
                if m and m:FindFirstChild("PlayerValue") and m.PlayerValue.Value == LocalPlayer.Name then
                    return m
                end
            end
        end
        return nil
    end

    function GKLib.spawnToy(toyName)
        local toy = GKLib.getToy(toyName)
        if toy then return toy end
        local menuToys = ReplicatedStorage:FindFirstChild("MenuToys")
        local root = GKLib.getRoot()
        if menuToys and menuToys:FindFirstChild("SpawnToyRemoteFunction") and root then
            pcall(function()
                menuToys.SpawnToyRemoteFunction:InvokeServer(toyName, root.CFrame, Vector3.zero)
            end)
            task.wait(0.1)
            return GKLib.getToy(toyName)
        end
        return nil
    end

    function GKLib.destroyToy(toyName)
        local toy = GKLib.getToy(toyName)
        local menuToys = ReplicatedStorage:FindFirstChild("MenuToys")
        if toy and menuToys and menuToys:FindFirstChild("DestroyToy") then
            pcall(function() menuToys.DestroyToy:FireServer(toy) end)
        end
    end

    -- 🧹 完整手臂與連接物件重置恢復
    function GKLib.resetHands()
        local blob = GKLib.getCurrentBlobman()
        pcall(function()
            local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
            
            -- 1. 銷毀所有玩家身上的 GrabLine
            if GE and GE:FindFirstChild("DestroyGrabLine") then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        GE.DestroyGrabLine:FireServer(p.Character.HumanoidRootPart)
                    end
                end
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    GE.DestroyGrabLine:FireServer(LocalPlayer.Character.HumanoidRootPart)
                end
            end

            -- 2. 透過 CreatureDrop 釋放雙手夾取的目標焊接 (Welds)
            if blob then
                local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
                local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
                
                for _, detName in ipairs({"RightDetector", "LeftDetector"}) do
                    local det = blob:FindFirstChild(detName)
                    if det then
                        for _, child in pairs(det:GetChildren()) do
                            if child:IsA("Weld") or child.Name:match("Weld") then
                                if CD then CD:FireServer(child) end
                            end
                        end
                    end
                end
            end
        end)
    end

    function GKLib.getCurrentBlobman()
        local hum = GKLib.getHum()
        if hum and hum.SeatPart then
            local seat = hum.SeatPart
            local model = seat.Parent
            if model and (model.Name == "CreatureBlobman" or model:FindFirstChild("BlobmanSeatAndOwnerScript")) then
                return model
            end
        end
        return GKLib.getToy("CreatureBlobman")
    end

    function GKLib.getBlobmanSeat()
        local blob = GKLib.getCurrentBlobman()
        if not blob then return nil end
        return blob:FindFirstChild("VehicleSeat") or blob:FindFirstChildOfClass("VehicleSeat") or blob:FindFirstChildOfClass("Seat")
    end

    function GKLib.isSittingOnBlobman()
        local hum = GKLib.getHum()
        local seat = GKLib.getBlobmanSeat()
        if not hum or not seat then return false end
        return hum.SeatPart == seat
    end

    function GKLib.ensureSitBlobman()
        local blob = GKLib.getCurrentBlobman() or GKLib.spawnToy("CreatureBlobman")
        if not blob then return false end
        local seat = GKLib.getBlobmanSeat()
        if not seat then return false end

        local occupant = seat.Occupant
        if occupant and occupant ~= GKLib.getHum() then
            local otherChar = occupant.Parent
            local otherPlayer = Players:GetPlayerFromCharacter(otherChar)
            local root = GKLib.getRoot()
            local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
            local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
            local GE = ReplicatedStorage:WaitForChild("GrabEvents", 1)
            local R_Det = blob:FindFirstChild("RightDetector")

            if otherPlayer and GKLib.IsTargetValid(otherPlayer) and root and CG and GE and R_Det then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    pcall(function()
                        local weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
                        occupant.Sit = false
                        GKLib.ApplyCFrame(otherRoot, root.CFrame + Vector3.new(0, 10, 0))
                        GE.SetNetworkOwner:FireServer(otherRoot, root.CFrame)
                        CG:FireServer(R_Det, otherRoot, weld)
                    end)
                    task.wait(0.05)
                end
            else
                occupant.Sit = false
            end
            task.wait(0.05)
        end

        local hum = GKLib.getHum()
        if hum and not GKLib.isSittingOnBlobman() then
            seat:Sit(hum)
            task.wait(0.05)
        end
        return GKLib.isSittingOnBlobman()
    end

    function GKLib.disableCreatureAnimations(blob)
        pcall(function()
            local ce = ReplicatedStorage:FindFirstChild("CreatureEvents")
            if ce then
                local animRemote = ce:FindFirstChild("PlayCreatureAnimation")
                if animRemote and animRemote:IsA("RemoteEvent") then
                    animRemote.OnClientEvent:Connect(function() return end)
                end
            end
        end)
    end

    function GKLib.EnsureReadyForKick()
        if not GKLib.isSittingOnBlobman() then
            GKLib.ensureSitBlobman()
            task.wait(0.1)
        end
        local seat = GKLib.getBlobmanSeat()
        if not seat then return nil, nil, nil, nil, nil end
        local blob = seat.Parent
        GKLib.disableCreatureAnimations(blob)
        local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
        local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
        local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
        local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
        local GE = ReplicatedStorage:WaitForChild("GrabEvents")
        return blob, blobRoot, CG, CD, GE
    end

    function GKLib.GrabTargetAtPos(blobRoot, target, CG, GE, detector, checkRunningFunc)
        local tChar = target and target.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot or not blobRoot then return end

        local weld = detector and (detector:FindFirstChild("RightWeld") or detector:FindFirstChild("LeftWeld") or detector:FindFirstChildWhichIsA("Weld"))
        local bringStart = tick()
        while tick() - bringStart < 0.15 and checkRunningFunc() do
            if not GKLib.IsTargetValid(target) then break end
            tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if not tRoot then break end
            
            GKLib.ApplyCFrame(blobRoot, tRoot.CFrame)
            pcall(function()
                if CG and detector then CG:FireServer(detector, tRoot, weld) end
                GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
            end)
            RunService.Heartbeat:Wait()
        end
    end

    function GKLib.ProcessSingleTargetKick(GE, CG, CD, detector, target, targetCF, humPlatformStand)
        if not GKLib.IsTargetValid(target) then return end
        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
        local tHum = target.Character:FindFirstChild("Humanoid")
        if not tRoot or not tHum then return end

        GKLib.KeepUpright(tRoot, targetCF)
        pcall(function()
            local weld = detector and (detector:FindFirstChild("RightWeld") or detector:FindFirstChild("LeftWeld") or detector:FindFirstChildWhichIsA("Weld"))
            if humPlatformStand then
                tHum.PlatformStand, tHum.Sit = true, true
            end
            GE.SetNetworkOwner:FireServer(tRoot, targetCF)
            if detector and weld then CD:FireServer(weld) end
            GE.DestroyGrabLine:FireServer(tRoot)
            if CG and detector then CG:FireServer(detector, tRoot, weld) end
            GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
        end)
    end

    -- ==========================================
    -- 2. UI 選單與動態玩家列表更新
    -- ==========================================
    local selectedTargetPlayer = nil
    local selectedLeftTarget = nil
    local selectedRightTarget = nil
    local selectedKickMode = "67踢"
