        toggleV1Kick(false) toggle67Kick(false) toggleUpDownKick(false) toggleAdvUpKick(false) toggleSlantKick(false) toggleDriftKick(false) toggle360CircleKick(false) toggleBackDriftKick(false) toggleDualKick(false)
