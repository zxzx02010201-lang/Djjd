    KickTab:AddToggle({Name = "開啟 上下踢（進階版）", Default = false, Callback = function(on) if autoSitEnabled then toggleAdvUpKick(on) else toggleAdvUpKick(false) end end})
    KickTab:AddToggle({Name = "開啟 斜踢", Default = false, Callback = function(on) if autoSitEnabled then toggleSlantKick(on) else toggleSlantKick(false) end end})
    KickTab:AddToggle({Name = "開啟 甩尾踢", Default = false, Callback = function(on) if autoSitEnabled then toggleDriftKick(on) else toggleDriftKick(false) end end})
    KickTab:AddToggle({Name = "開啟 360度踢", Default = false, Callback = function(on) if autoSitEnabled then toggle360CircleKick(on) else toggle360CircleKick(false) end end})
    KickTab:AddToggle({Name = "開啟 背甩踢", Default = false, Callback = function(on) if autoSitEnabled then toggleBackDriftKick(on) else toggleBackDriftKick(false) end end})
    KickTab:AddToggle({Name = "開啟 雙踢模式", Default = false, Callback = function(on) if autoSitEnabled then toggleDualKick(on) else toggleDualKick(false) end end})

end)
